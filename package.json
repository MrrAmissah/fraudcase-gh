{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/lib/gemini/*.test.ts\" \"src/lib/security/*.test.ts\" \"src/lib/observability/*.test.ts\" \"src/lib/extraction/__tests__/*.test.ts\" \"src/lib/config/*.test.ts\" \"src/lib/threat-intel/__tests__/*.test.ts\" \"src/lib/cases/*.test.ts\"",
    "test:smoke": "node scripts/smoke-server.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:multimodal-readiness": "node scripts/check-multimodal-readiness.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "multer": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
